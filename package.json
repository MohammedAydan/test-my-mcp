{
  "name": "motionforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-grade programmatic motion graphics & video engine with a decoupled MCP adapter.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
