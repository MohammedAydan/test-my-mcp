{
  "name": "motionforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-grade programmatic motion graphics & video engine with a decoupled MCP adapter.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run dev -w @motionforge/desktop",
    "start": "npm run dev -w @motionforge/desktop",
    "dev:desktop": "npm run dev -w @motionforge/desktop",
    "dev:studio": "npm run dev -w @motionforge/studio",
    "test:ui": "node scripts/test-phase2.cjs",
    "init-project": "node --import tsx scripts/init-project.mjs",
    "sync-scene": "node --import tsx scripts/sync-scene.mjs",
    "pull-render": "node --import tsx scripts/pull-render.mjs",
    "sync-template-scenes": "node --import tsx scripts/sync-template-scenes.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
